{
	"name": "sol-pi",
	"version": "0.1.0",
	"description": "Standalone context and tool-efficiency extensions for oh-my-pi",
	"type": "module",
	"private": true,
	"files": [
		"src/sol-pi",
		"assets",
		"docs/compatibility.md",
		"docs/configuration.md",
		"scripts/check-sol-pi-config.mjs",
		"scripts/check-omp-compat.mjs",
		"agents-install.md",
		"README.md",
		"LICENSE",
		"CONTRIBUTING.md",
		"SECURITY.md",
		"THIRD_PARTY_NOTICES.md",
		"sol-pi.example.json"
	],
	"scripts": {
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"check": "bun run typecheck && bun test",
		"check:omp": "node scripts/check-omp-compat.mjs"
	},
	"keywords": [
		"omp-extension",
		"context-management"
	],
	"omp": {
		"extensions": [
			"./src/sol-pi/index.ts"
		]
	},
	"peerDependencies": {
		"@oh-my-pi/omptype": "*",
		"@oh-my-pi/pi-agent-core": "*",
		"@oh-my-pi/pi-ai": "*",
		"@oh-my-pi/pi-coding-agent": "*",
		"@oh-my-pi/pi-tui": "*",
		"@oh-my-pi/pi-utils": "*"
	},
	"devDependencies": {
		"@oh-my-pi/omptype": "18.2.0",
		"@oh-my-pi/pi-agent-core": "18.2.0",
		"@oh-my-pi/pi-ai": "18.2.0",
		"@oh-my-pi/pi-coding-agent": "18.2.0",
		"@oh-my-pi/pi-tui": "18.2.0",
		"@oh-my-pi/pi-utils": "18.2.0",
		"@types/bun": "1.4.2",
		"@types/node": "24.12.4",
		"typescript": "5.9.3"
	},
	"engines": {
		"bun": ">=1.3.14",
		"node": ">=22.19.0"
	},
	"overrides": {
		"nanoid": "3.3.18",
		"postcss": "8.5.26",
		"protobufjs": "7.6.5"
	},
	"license": "MIT"
}
